    "/api/v1/runs/{run_id}/cut": {
      "get": {
        "description": "The cut in the order it plays, each shot with every reason the run recorded for it.",
        "operationId": "read_cut_api_v1_runs__run_id__cut_get",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
