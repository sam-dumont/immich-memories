  "info": {
    "title": "Immich Memories",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/assets/{asset_id}/thumbnail": {
      "get": {
        "description": "The picture at grid or preview size; a miss is fetched from Immich and kept.",
        "operationId": "thumbnail_api_v1_assets__asset_id__thumbnail_get",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "title": "Asset Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "default": "thumbnail",
              "enum": [
                "thumbnail",
                "preview"
              ],
              "title": "Size",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Thumbnail",
        "tags": [
          "media"
        ]
      }
    },
    "/api/v1/assets/{asset_id}/video": {
      "get": {
        "description": "The playback rendition, streamed by byte range so the preview can seek to the cut's interval.",
        "operationId": "video_api_v1_assets__asset_id__video_get",
        "parameters": [
          {
            "in": "path",
            "name": "asset_id",
            "required": true,
            "schema": {
              "title": "Asset Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "range",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Range"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Video",
        "tags": [
          "media"
        ]
      }
    },
    "/api/v1/i18n": {
      "get": {
        "description": "The browser's language, or the one the viewer chose; a missing string falls back to English.",
        "operationId": "messages_api_v1_i18n_get",
        "parameters": [
          {
            "in": "query",
            "name": "preference",
            "required": false,
            "schema": {
              "default": "auto",
              "title": "Preference",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "accept-language",
            "required": false,
            "schema": {
              "default": "",
              "title": "Accept-Language",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Messages"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Messages",
        "tags": [
          "i18n"
        ]
      }
    },
    "/api/v1/runs": {
      "get": {
        "description": "Runs newest first, each with the first pictures its saved cut plays.",
        "operationId": "list_runs_api_v1_runs_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "completed",
                    "failed",
                    "running",
                    "cancelled",
                    "interrupted"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Runs",
        "tags": [
          "runs"
        ]
      }
    },
    "/api/v1/runs/{run_id}": {
      "get": {
        "description": "One run as `runs show` reads it: outcome, output, delivery, warnings and phase timings.",
