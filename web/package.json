{
  "name": "immich-memories-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "api-types": "openapi-typescript ../src/immich_memories/web/openapi.json -o src/lib/api-types.ts"
  },
  "devDependencies": {
    "@immich/ui": "0.92.0",
    "@mdi/js": "7.4.47",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/instrumentation": "0.301.0",
    "@opentelemetry/instrumentation-document-load": "0.70.0",
    "@opentelemetry/instrumentation-fetch": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "openapi-typescript": "7.13.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.6"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "runed": "0.38.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
