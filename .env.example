# Immich Memories — environment variables
# Copy to .env and fill in your values.

# Required: Immich server connection
IMMICH_URL=https://photos.example.com
IMMICH_API_KEY=your-api-key-here

# Optional: session secret (auto-generated if not set, set for multi-replica/K8s).
# 32+ random characters, or the server refuses to start.
# generate: openssl rand -hex 32
# IMMICH_MEMORIES_STORAGE_SECRET=

# Optional: basic auth for the web UI
# IMMICH_MEMORIES_AUTH_USERNAME=admin
# 12 characters or more; generate: openssl rand -hex 16
# IMMICH_MEMORIES_AUTH_PASSWORD=

# Optional: LLM for clip content analysis (any OpenAI- or Anthropic-compatible API)
# IMMICH_MEMORIES_LLM__BASE_URL=http://your-llm:8080/v1
# IMMICH_MEMORIES_LLM__MODEL=qwen2.5-vl

# Optional: a hosted model instead. Only the matching provider's key is read.
# IMMICH_MEMORIES_LLM__PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
