# Copy to .env beside docker-compose.yml. Set the Immich URL and key.
IMMICH_MEMORIES_VERSION=1.0.0
IMMICH_URL=http://192.168.1.10:2283
IMMICH_API_KEY=
TZ=Etc/UTC
# One file = Basic. GPU/full add their tier files; CUDA adds its hardware override.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml:docker-compose.cuda.yml
TIER=basic
# Remote combined GPU worker instead of local tier services:
GPU_BOX=
# Full or reader-only Basic: opt in explicitly, then enter the reader endpoint/model.
READER_ENABLED=false
READER_URL=
READER_API_KEY=
READER_MODEL=
# Settings can save secrets after this 32+ character key is set.
# IMMICH_MEMORIES_SECRET_KEY=
# Sign-in is on. Leave these empty to get a generated password (docker logs immich-memories),
# or set both to choose your own. Password: 12+ characters.
# IMMICH_MEMORIES_AUTH_USERNAME=
# IMMICH_MEMORIES_AUTH_PASSWORD=
UI_BIND_ADDRESS=127.0.0.1
