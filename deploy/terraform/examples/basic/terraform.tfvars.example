# Copy this file to terraform.tfvars and fill in your values

# Pin a release; the deployment bundle fills this in.
image_tag = "replace-with-a-release-tag"

# Immich connection (in-cluster: http://immich-server.<namespace>.svc.cluster.local:2283)
immich_url     = "https://photos.example.com"
immich_api_key = "your-immich-api-key-here"

# Optional text reader: explicitly enable through the module env map
# llm_base_url = "http://ollama.ollama.svc.cluster.local:11434/v1"
# llm_model    = "your-served-text-model"
# llm_api_key  = ""

# Optional: NVIDIA GPU nodes
# gpu_enabled = true
