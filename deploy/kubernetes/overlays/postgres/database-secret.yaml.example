# cp database-secret.yaml.example database-secret.yaml && edit. Gitignored like base/secret.yaml.
#
# IMMICH_MEMORIES_DATABASE_URL is a SQLAlchemy URL with the psycopg 3 driver.
# Three shapes, all valid here (see docs-site/docs/run/database.md):
#   - a separate PostgreSQL service:
#       postgresql+psycopg://immich_memories:change-me@postgres:5432/immich_memories
#   - a separate database on your existing Immich PostgreSQL instance:
#       postgresql+psycopg://immich_memories:change-me@immich-postgres:5432/immich_memories
#   - the existing Immich database, in a dedicated schema and role (create the
#     role and schema first — see the docs page for the exact SQL, and set
#     database-secret's schema to match):
#       postgresql+psycopg://immich_memories:change-me@immich-postgres:5432/immich
apiVersion: v1
kind: Secret
metadata:
  name: immich-memories-database
  namespace: immich-memories
  labels:
    app.kubernetes.io/name: immich-memories
type: Opaque
stringData:
  IMMICH_MEMORIES_DATABASE_URL: "postgresql+psycopg://immich_memories:change-me@postgres:5432/immich_memories"
  # Only needed for the dedicated-schema mode; defaults to immich_memories.
  # IMMICH_MEMORIES_DATABASE_SCHEMA: "immich_memories"
