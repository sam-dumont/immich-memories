# Fill in a copy outside the checkout and `kubectl apply -f` it before the
# overlay; the overlay does not list it. config-map.yaml's config.yaml expands
# these with ${VAR}; leave a value empty to leave that field unset.
apiVersion: v1
kind: Secret
metadata:
  name: immich-memories-maximalist
  namespace: immich-memories
  labels:
    app.kubernetes.io/name: immich-memories
type: Opaque
stringData:
  OIDC_ISSUER_URL: "https://idp.example.com/realms/family"
  OIDC_CLIENT_ID: "immich-memories"
  OIDC_CLIENT_SECRET: "change-me"
  # Empty is fine: most self-hosted OpenAI-compatible servers on a LAN take no key.
  LLM_API_KEY: ""
  ACE_STEP_API_KEY: ""
