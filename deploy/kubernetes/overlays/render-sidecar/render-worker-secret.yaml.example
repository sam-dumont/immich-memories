# cp render-worker-secret.yaml.example render-worker-secret.yaml && edit.
# render-worker-secret.yaml is gitignored.
#
# One Secret, two consumers in the same pod: the sidecar container reads
# `token`/`immich-url` directly (IMMICH_MEMORIES_RENDER_WORKER_* prefix), and
# the app container's patch maps the same `token` key onto
# IMMICH_MEMORIES_RENDER__WORKER_TOKEN (two underscores, the app's own render
# section) so both sides present the same bearer token.
apiVersion: v1
kind: Secret
metadata:
  name: immich-memories-render-worker
  namespace: immich-memories
  labels:
    app.kubernetes.io/name: immich-memories-render-worker
type: Opaque
stringData:
  # openssl rand -hex 32
  token: "replace-with-openssl-rand-hex-32"
  # The worker fetches originals itself with the app's own Immich credentials.
  immich-url: "https://photos.example.com"
