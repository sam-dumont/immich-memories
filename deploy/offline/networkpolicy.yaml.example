# REPLACE the base policy with this same-name policy after fetching models.
# Edit the Immich and DNS selectors for your cluster before applying.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: immich-memories
  namespace: immich-memories
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: immich-memories
  policyTypes: [Ingress, Egress]
  ingress:
    - ports:
        - {port: 8080, protocol: TCP}
  egress:
    # Trigger jobs reach the web pod in this namespace, on its target port.
    - to:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: immich-memories
              app.kubernetes.io/component: web-ui
      ports:
        - {port: 8080, protocol: TCP}
    # Use actual DNS pod labels, or your NodeLocal DNS IP/32, not all port 53.
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: kube-system
          podSelector:
            matchLabels:
              k8s-app: kube-dns
      ports:
        - {port: 53, protocol: UDP}
        - {port: 53, protocol: TCP}
    # Immich running in this cluster: select its pods, even if the app connects through a
    # LoadBalancer IP. Cilium (and some other CNIs) match policy on the backend pod, so an
    # ipBlock for that IP never matches. Replace the namespace and the pod label with yours.
    - to:
        - namespaceSelector:
            matchLabels:
              kubernetes.io/metadata.name: immich
          podSelector:
            matchLabels:
              app.kubernetes.io/name: server
      ports:
        - {port: 2283, protocol: TCP}
    # Immich outside the cluster instead: delete the rule above and use its fixed IP.
    # 192.0.2.10 is a documentation-only address.
    # - to:
    #     - ipBlock:
    #         cidr: 192.0.2.10/32
    #   ports:
    #     - {port: 2283, protocol: TCP}
    # Optional LAN/in-cluster model services: leave out for NAS.
    # Add separate rules for exact namespaceSelector+podSelector and TCP port.
    # Do not add a ports-only rule: that allows every destination on that port.
